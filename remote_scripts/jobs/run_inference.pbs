#!/bin/bash
#PBS -N agri_infer
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=2
#PBS -l walltime=08:00:00
#PBS -q workq
#PBS -j oe
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/inference.log

cd /Data1/ece_23104085/agri-perceiver
mkdir -p logs results

exec > >(tee -a "logs/${PBS_JOBID}_inference.log")
exec 2>&1

echo "=== AgriPerceiver Inference Job Started at $(date) ==="
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"

# Environment
export HF_HOME=/Data1/ece_23104085/hf_cache
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

# MIG setup — single 47GB MIG partition from GPU 0
export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

echo "Python: $(python --version)"
nvidia-smi -L 2>/dev/null
echo ""

# === Convert ground truth format ===
python scripts/convert_gt.py data/test_split.jsonl data/test_split_gt.jsonl

# === Run full inference on test split ===
echo "=== Starting inference at $(date) ==="
python scripts/run_inference.py \
    --checkpoint checkpoints/specialist_e3.pt \
    --test-data data/test_split.jsonl \
    --image-root /Data1/ece_23104085/canonical_dataset/processed_images \
    --output results/predictions.jsonl \
    --resume

EXIT_CODE=$?
echo "=== Inference completed at $(date) with exit code: $EXIT_CODE ==="

# === Run evaluation ===
if [ $EXIT_CODE -eq 0 ]; then
    echo "=== Starting evaluation at $(date) ==="
    python -m agri_perceiver.evaluation.run_eval \
        --predictions results/predictions.jsonl \
        --ground-truth data/test_split_gt.jsonl \
        --output results/eval_results.json
    echo "=== Evaluation completed at $(date) ==="
fi

echo "=== Job Finished at $(date) ==="
exit $EXIT_CODE
