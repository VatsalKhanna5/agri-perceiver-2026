#!/bin/bash
#PBS -N agri_dl_models
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=02:00:00
#PBS -q workq
#PBS -j oe
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/download_models.log

cd /Data1/ece_23104085/agri-perceiver
mkdir -p logs

exec > >(tee -a "logs/${PBS_JOBID}_download.log")
exec 2>&1

echo "=== Download Models Job Started at $(date) ==="
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"

# Environment
export HF_HOME=/Data1/ece_23104085/hf_cache
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

echo "Python: $(python --version)"
echo "HF_HOME: $HF_HOME"

# MIG setup - use a free MIG partition
export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

python scripts/download_backbones.py
EXIT_CODE=$?

echo "=== Download Models Job Finished at $(date) with exit code: $EXIT_CODE ==="
exit $EXIT_CODE
