#!/bin/bash
#PBS -N agri_test
#PBS -l select=1:ncpus=4:mem=48gb
#PBS -l walltime=01:00:00
#PBS -q workq
#PBS -j oe
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/test_model.log

cd /Data1/ece_23104085/agri-perceiver
mkdir -p logs

exec > >(tee -a "logs/${PBS_JOBID}_test.log")
exec 2>&1

echo "=== Test Model Job Started at $(date) ==="
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"

# Environment
export HF_HOME=/Data1/ece_23104085/hf_cache
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

# MIG setup - single 47GB MIG partition (enough for ~4.2B model in bf16)
export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

nvidia-smi -L 2>/dev/null
echo ""

python scripts/test_model_load.py
EXIT_CODE=$?

echo "=== Test Model Job Finished at $(date) with exit code: $EXIT_CODE ==="
exit $EXIT_CODE
