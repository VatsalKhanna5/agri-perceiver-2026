#!/bin/bash
#PBS -N abl_notile
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/ablation_no_tile_embed.log
#PBS -j oe
#PBS -V

echo "=== Ablation: No Tile Embeddings at $(date) ==="

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

export HF_HOME=/Data1/ece_23104085/hf_cache
export CUDA_VISIBLE_DEVICES=MIG-2f219700-5dc6-59eb-81ef-2bb9414d3ec0
cd /Data1/ece_23104085/agri-perceiver

python scripts/run_ablation.py \
    --ablation no_tile_embed \
    --checkpoint checkpoints/specialist_e3.pt \
    --test-data data/test_split.jsonl \
    --image-root /Data1/ece_23104085/canonical_dataset/processed_images \
    --output results/ablation_no_tile_embed_predictions.jsonl \
    --resume

echo "=== Validating ==="
python scripts/validate_predictions.py results/ablation_no_tile_embed_predictions.jsonl

echo "=== Running evaluation ==="
python -m agri_perceiver.evaluation.run_eval \
    --predictions results/ablation_no_tile_embed_predictions.jsonl \
    --ground-truth data/test_split_gt.jsonl \
    --output results/ablation_no_tile_embed_eval.json

echo "=== Done at $(date) ==="
