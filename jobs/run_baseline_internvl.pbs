#!/bin/bash
#PBS -N bl_internvl
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -l walltime=48:00:00
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/baseline_internvl.log
#PBS -j oe
#PBS -V

echo "=== InternVL2-8B Baseline at $(date) ==="

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

export HF_HOME=/Data1/ece_23104085/hf_cache
export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480
cd /Data1/ece_23104085/agri-perceiver

python scripts/run_baseline_inference.py \
    --model internvl2 \
    --test-data data/test_split.jsonl \
    --image-root /Data1/ece_23104085/canonical_dataset/processed_images \
    --output results/internvl2_predictions.jsonl \
    --resume

echo "=== Validating ==="
python scripts/validate_predictions.py results/internvl2_predictions.jsonl

echo "=== Running evaluation ==="
python -m agri_perceiver.evaluation.run_eval \
    --predictions results/internvl2_predictions.jsonl \
    --ground-truth data/test_split_gt.jsonl \
    --output results/internvl2_eval_results.json

echo "=== InternVL2 done at $(date) ==="
