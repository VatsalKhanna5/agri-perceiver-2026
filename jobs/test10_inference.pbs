#!/bin/bash
#PBS -N agri_test10
#PBS -q workq
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/test10_inference.log
#PBS -j oe
#PBS -V

echo "=== Quick 10-sample test at $(date) ==="
echo "Job ID: $PBS_JOBID"

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

export HF_HOME=/Data1/ece_23104085/hf_cache
export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480

cd /Data1/ece_23104085/agri-perceiver

echo "=== Running 10-sample inference ==="
python scripts/run_inference.py \
    --checkpoint checkpoints/specialist_e3.pt \
    --test-data data/test_split.jsonl \
    --image-root /Data1/ece_23104085/canonical_dataset/processed_images \
    --output results/test10_predictions.jsonl \
    --max-samples 10

echo "=== Validating output ==="
python scripts/validate_predictions.py results/test10_predictions.jsonl

echo "=== Test done at $(date) ==="
