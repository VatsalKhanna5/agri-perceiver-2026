#!/bin/bash
#PBS -N bl_llava
#PBS -q workq
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1
#PBS -l walltime=48:00:00
#PBS -o /Data1/ece_23104085/agri-perceiver/logs/baseline_llava.log
#PBS -j oe
#PBS -V

echo "=== LLaVA-NeXT-7B Baseline at $(date) ==="

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate inference-engine

export HF_HOME=/Data1/ece_23104085/hf_cache
export CUDA_VISIBLE_DEVICES=MIG-2f219700-5dc6-59eb-81ef-2bb9414d3ec0
cd /Data1/ece_23104085/agri-perceiver

python scripts/run_baseline_inference.py \
    --model llava_next \
    --test-data data/test_split.jsonl \
    --image-root /Data1/ece_23104085/canonical_dataset/processed_images \
    --output results/llava_next_predictions.jsonl \
    --resume

echo "=== Validating ==="
python scripts/validate_predictions.py results/llava_next_predictions.jsonl

echo "=== Running evaluation ==="
python -m agri_perceiver.evaluation.run_eval \
    --predictions results/llava_next_predictions.jsonl \
    --ground-truth data/test_split_gt.jsonl \
    --output results/llava_next_eval_results.json

echo "=== LLaVA done at $(date) ==="
